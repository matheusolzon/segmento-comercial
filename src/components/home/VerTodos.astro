---
/* "Ver todos" de prateleira: cartão no fim da fileira (onde o dedo chega rolando) + botão cheio embaixo.
 * Antes era um link de texto e passava batido (Matheus, 20/10). */
import { ArrowRight } from "lucide-react";
interface Props { href: string; total: number; nome: string; modo: "cartao" | "botao" }
const { href, total, nome, modo } = Astro.props;
---
{modo === "cartao" ? (
  <li class="w-1/2 shrink-0 border-b border-r border-line sm:w-1/3 lg:w-1/4">
    <a href={href} class="group flex h-full min-h-[320px] flex-col items-center justify-center gap-4 bg-zinco p-5 text-center hover:bg-zinco-2">
      <span class="flex h-16 w-16 items-center justify-center bg-vinho text-white transition-colors group-hover:bg-vinho-deep"><ArrowRight className="h-7 w-7 transition-transform group-hover:translate-x-1" aria-hidden="true" /></span>
      <span class="t-banner text-[22px]">Ver todos</span>
      <span class="text-sm text-ink-muted">Os {total} itens de {nome}</span>
    </a>
  </li>
) : (
  <div class="mt-5 flex justify-center">
    <a href={href} class="btn-primary w-full sm:w-auto sm:min-w-[360px]">Ver todos os {total} itens de {nome} <ArrowRight className="h-5 w-5" aria-hidden="true" /></a>
  </div>
)}
