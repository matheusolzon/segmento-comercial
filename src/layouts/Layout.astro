---
/* Casca de toda página. NOINDEX por padrão: demo de pré-venda em domínio nosso.
 * Flip pra index só depois do sim e no domínio do cliente (PUBLIC_INDEXAVEL=true). */
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PedidoBar from "../components/islands/PedidoBar";
import { EMPRESA } from "../lib/site";

interface Props { title: string; description: string; jsonLd?: Record<string, unknown>[]; ogImage?: string; }
const { title, description, jsonLd = [], ogImage = "/og.png" } = Astro.props;
const indexavel = import.meta.env.PUBLIC_INDEXAVEL === "true";
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const og = new URL(ogImage, Astro.site).toString();
const grafo = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Store", "@id": `${Astro.site}#loja`, name: EMPRESA.nome, legalName: EMPRESA.legalName, taxID: EMPRESA.cnpj,
      url: Astro.site, telephone: EMPRESA.telefoneE164, email: EMPRESA.email, image: og,
      address: { "@type": "PostalAddress", streetAddress: EMPRESA.endereco.rua, addressLocality: EMPRESA.endereco.cidade, addressRegion: EMPRESA.endereco.uf, postalCode: EMPRESA.endereco.cep, addressCountry: "BR" },
      sameAs: [EMPRESA.instagram, EMPRESA.youtube],
    },
    ...jsonLd,
  ],
};
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexavel ? "index, follow" : "noindex, nofollow"} />
    <meta name="theme-color" content="#1e1d1b" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:site_name" content={EMPRESA.nome} />
    <link rel="preload" href="/fonts/clash-display-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/switzer-400.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={JSON.stringify(grafo)} is:inline />
  </head>
  <body class="bg-bg text-ink">
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <PedidoBar client:idle />
    <script>
      import { initWhatsappTracking } from "../lib/gtm";
      import "../scripts/pedido-cards";
      initWhatsappTracking();
    </script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      document.addEventListener("click", (e) => {
        const el = e.target instanceof Element ? e.target.closest("[data-wa]") : null;
        if (el) window.dataLayer.push({ event: "whatsapp_click", wa_location: el.getAttribute("data-wa") || "cta" });
      });
    </script>
  </body>
</html>
