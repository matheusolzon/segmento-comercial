---
/* Home v2 (20/10): varejo no modelo Super EPI / Loja do Mecânico. Carrossel de banners + atalhos + categorias com foto
 * + vitrines + segmentos + fábrica + marcas + prova. Banners em HTML (produto real recortado + foto de banco + tipografia). */
import Layout from "../layouts/Layout.astro";
import HeroCarrossel from "../components/home/HeroCarrossel.astro";
import Atalhos from "../components/home/Atalhos.astro";
import CategoriasFoto from "../components/home/CategoriasFoto.astro";
import VitrineAbas from "../components/home/VitrineAbas.astro";
import BannerDuplo from "../components/home/BannerDuplo.astro";
import Segmentos from "../components/home/Segmentos.astro";
import Vitrine from "../components/home/Vitrine.astro";
import FabricaFotos from "../components/home/FabricaFotos.astro";
import { PRODUTOS } from "../lib/catalogo";
import { vitrine, MARCAS, totalDe } from "../lib/home";
import { EMPRESA } from "../lib/site";
import { MapPin, Phone, Star } from "lucide-react";
const sinalizacao = vitrine("sinalizacao-e-seguranca", 8, [9311, 5351, 6640, 4617]);
const ferramentas = vitrine("ferramentas-e-ferragens", 8, [16590, 4292, 15693, 20814]);
const nMarcas = new Set(PRODUTOS.map((p) => p.marca).filter(Boolean)).size;
const fatos = [[`${EMPRESA.anos} anos`, "em Casa Verde Alta, SP"], [`${EMPRESA.googleNota} no Google`, `${EMPRESA.googleAvaliacoes} avaliações`], [`${PRODUTOS.length} itens`, "no catálogo online"], ["Fábrica própria", "CNC e laser"]];
---
<Layout title="Segmento Comercial · EPI com CA, ferragens, sinalização e placas sob medida em São Paulo" description="Distribuidora de EPI com número de CA, ferramentas, sinalização de segurança e fabricação própria de placas de trânsito, veicular e fachadas em ACM. Casa Verde, São Paulo. Pedido pelo WhatsApp e cotação para CNPJ.">
  <h1 class="sr-only">Segmento Comercial: EPI, ferragens, sinalização e placas sob medida em São Paulo</h1>
  <HeroCarrossel />
  <Atalhos />
  <CategoriasFoto />
  <VitrineAbas />
  <BannerDuplo />
  <Segmentos />
  <Vitrine id="h-sinalizacao" titulo="Sinalização para obra e condomínio" href="/c/sinalizacao-e-seguranca/" linkTexto={`Ver os ${totalDe("sinalizacao-e-seguranca")} itens`} produtos={sinalizacao} />
  <FabricaFotos />
  <Vitrine id="h-ferramentas" titulo="Ferramentas e ferragens" href="/c/ferramentas-e-ferragens/" linkTexto={`Ver os ${totalDe("ferramentas-e-ferragens")} itens`} produtos={ferramentas} />

  <section class="container-x mt-12" aria-labelledby="h-marcas">
    <div class="secao-cabeca"><h2 id="h-marcas">Marcas no estoque</h2><span class="text-sm text-ink-muted">{nMarcas} marcas</span></div>
    <ul class="grade grid-cols-3 sm:grid-cols-4 lg:grid-cols-6">
      {MARCAS.map((m) => (
        <li><a href={`/busca/?q=${encodeURIComponent(m.nome)}`} class="flex h-20 flex-col items-center justify-center bg-surface px-2 text-center hover:bg-zinco"><span class="text-[13px] font-semibold uppercase tracking-[0.02em] sm:text-[17px]">{m.nome}</span><span class="text-[12px] text-ink-muted">{m.total} itens</span></a></li>
      ))}
    </ul>
  </section>

  <section class="container-x mt-12" aria-label="Sobre a loja">
    <ul class="grade grid-cols-2 md:grid-cols-4">
      {fatos.map(([a, b]) => <li class="bg-surface p-4"><span class="block text-[20px] font-semibold leading-6">{a}</span><span class="block text-sm text-ink-muted">{b}</span></li>)}
    </ul>
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      <div class="border border-line p-5">
        <div class="flex items-center gap-2"><Star className="h-5 w-5 fill-seg text-ink" aria-hidden="true" /><span class="text-[20px] font-semibold">{EMPRESA.googleNota}</span><span class="text-sm text-ink-muted">no Google, {EMPRESA.googleAvaliacoes} avaliações</span></div>
        <p class="mt-2 text-sm text-ink-muted">Avaliações reais entram aqui na versão final, com data e nome.</p>
      </div>
      <div class="border border-line p-5">
        <p class="flex items-start gap-2 text-sm"><MapPin className="mt-0.5 h-4 w-4 shrink-0 text-vinho" aria-hidden="true" /><span>{EMPRESA.endereco.rua}, {EMPRESA.endereco.bairro}, {EMPRESA.endereco.cidade}. {EMPRESA.horario}.</span></p>
        <p class="mt-2 flex items-center gap-2 text-sm"><Phone className="h-4 w-4 shrink-0 text-vinho" aria-hidden="true" /><a href={`tel:${EMPRESA.telefoneE164}`} class="font-semibold hover:underline">{EMPRESA.telefone}</a><span class="text-ink-muted">· retirada no balcão</span></p>
        <a href="/contato/" class="mt-3 inline-block text-sm font-medium text-vinho-deep hover:underline">Como chegar e horários</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  /* Setas das fileiras roláveis: rola uma tela; desliga a seta no começo/fim. Na vitrine com abas, vale o painel visível. */
  const listaDe = (raiz: Element) => [...raiz.querySelectorAll<HTMLElement>("[data-rolagem-lista]")].find((l) => !l.closest("[hidden]"));
  const atualizarSetas = (raiz: Element) => {
    const l = listaDe(raiz); if (!l) return;
    const [a, b] = raiz.querySelectorAll<HTMLButtonElement>("[data-rolar]");
    if (a) a.disabled = l.scrollLeft <= 2;
    if (b) b.disabled = l.scrollLeft + l.clientWidth >= l.scrollWidth - 2;
  };
  document.querySelectorAll("[data-rolagem]").forEach((raiz) => {
    raiz.querySelectorAll("[data-rolagem-lista]").forEach((l) => l.addEventListener("scroll", () => atualizarSetas(raiz), { passive: true }));
    raiz.querySelectorAll<HTMLButtonElement>("[data-rolar]").forEach((b) => b.addEventListener("click", () => {
      const l = listaDe(raiz); if (!l) return;
      const reduz = matchMedia("(prefers-reduced-motion: reduce)").matches;
      l.scrollBy({ left: Number(b.dataset.rolar) * l.clientWidth * 0.92, behavior: reduz ? "auto" : "smooth" });
    }));
    atualizarSetas(raiz);
  });
  /* Abas (padrão WAI: setas entre abas, Home/End) */
  document.querySelectorAll("[data-abas]").forEach((raiz) => {
    const abas = [...raiz.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const ativar = (aba: HTMLButtonElement, foco = false) => {
      abas.forEach((x) => { const on = x === aba; x.setAttribute("aria-selected", String(on)); x.tabIndex = on ? 0 : -1; document.getElementById(x.getAttribute("aria-controls")!)!.hidden = !on; });
      if (foco) aba.focus();
      atualizarSetas(raiz);
    };
    abas.forEach((aba, i) => {
      aba.addEventListener("click", () => ativar(aba));
      aba.addEventListener("keydown", (e) => {
        const alvo = e.key === "ArrowRight" ? abas[(i + 1) % abas.length] : e.key === "ArrowLeft" ? abas[(i - 1 + abas.length) % abas.length] : e.key === "Home" ? abas[0] : e.key === "End" ? abas[abas.length - 1] : null;
        if (alvo) { e.preventDefault(); ativar(alvo, true); }
      });
    });
  });
</script>
