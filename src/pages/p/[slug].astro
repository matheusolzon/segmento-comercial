---
import Layout from "../../layouts/Layout.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import SeletorVariacao from "../../components/islands/SeletorVariacao";
import ProdutoCardR from "../../components/islands/ProdutoCardR";
import { PRODUTOS, relacionados, precoExibido } from "../../lib/catalogo";
import { paraCard } from "../../lib/para-card";
import { ShieldCheck, Truck, Store, FileText } from "lucide-react";
export const getStaticPaths = () => PRODUTOS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
const { p } = Astro.props;
const cat = p.categoria_nova;
const rel = relacionados(p, 4).map(paraCard);
const vars = p.variacoes.map((v) => ({ id: v.id, sku: v.sku, atributos: v.atributos, preco: v.preco, em_estoque: v.em_estoque, estoque: v.estoque, img800: v.imagem?.w800 ?? null }));
const jsonLd = [{
  "@type": "Product", name: p.nome, sku: p.sku, ...(p.marca ? { brand: { "@type": "Brand", name: p.marca } } : {}),
  ...(p.imagem ? { image: new URL(p.imagem.w800, Astro.site).toString() } : {}),
  ...(p.descricao_texto ? { description: p.descricao_texto.slice(0, 300) } : {}),
  offers: { "@type": "Offer", priceCurrency: "BRL", price: (p.preco_min ?? p.preco).toFixed(2), availability: p.em_estoque ? "https://schema.org/InStock" : "https://schema.org/OutOfStock", url: new URL(`/p/${p.slug}/`, Astro.site).toString(), seller: { "@id": `${Astro.site}#loja` } },
}];
const descricaoMeta = `${p.nome}${p.marca ? ` ${p.marca}` : ""}, REF ${p.sku}${p.ca ? `, CA ${p.ca.numero}` : ""}. ${precoExibido(p)}. ${p.em_estoque ? "Em estoque" : "Sob consulta"} na Segmento Comercial, Casa Verde, São Paulo. Pedido pelo WhatsApp ou cotação para CNPJ.`;
---
<Layout title={`${p.nome}${p.marca ? ` ${p.marca}` : ""} · REF ${p.sku} · Segmento Comercial`} description={descricaoMeta} jsonLd={jsonLd} ogImage={p.imagem?.w800}>
  <article class="container-x py-6">
    <Breadcrumb itens={[{ nome: cat.nome_n1, href: `/c/${cat.n1}/` }, { nome: cat.nome_n2, href: `/c/${cat.n1}/${cat.n2}/` }, { nome: p.nome }]} />
    <div class="mt-4 grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)] lg:gap-12">
      <div class="border border-line bg-surface">
        {p.imagem
          ? <img data-foto-produto src={p.imagem.w800} srcset={`${p.imagem.w320} 320w, ${p.imagem.w800} 800w`} sizes="(min-width:1024px) 55vw, 100vw" alt={p.nome} width="800" height="800" class="aspect-square w-full object-contain p-6" fetchpriority="high" />
          : <div class="flex aspect-square items-center justify-center bg-zinco text-sm text-faint">Foto a cadastrar</div>}
      </div>
      <div>
        <p class="rotulo">{p.marca ?? cat.nome_n2}</p>
        <h1 class="mt-2 !text-[24px] !leading-7 sm:!text-[32px] sm:!leading-9">{p.nome}</h1>
        <div class="etiqueta etiqueta-lg mt-3" title={`Nome no cadastro atual: ${p.nome_original}`}>
          <span><span class="rot">REF</span><span class="val">{p.sku}</span></span>
          {p.marca && <span><span class="rot">Marca</span><span class="val">{p.marca}</span></span>}
          {p.ca ? <span class="ca"><span class="rot">CA</span><span class="val">{p.ca.numero}</span></span> : p.eh_epi ? <span><span class="rot">CA</span><span class="val text-ink-muted">consultar</span></span> : null}
          {p.normas.slice(0, 2).map((n) => <span><span class="val">{n}</span></span>)}
        </div>
        {p.ca && <p class="mt-2 text-[13px] text-ink-muted">Certificado de Aprovação do Ministério do Trabalho. <a href={`https://consultaca.com/${p.ca.numero}`} target="_blank" rel="noopener" class="underline hover:text-ink">Conferir validade no CAEPI</a>.</p>}
        {p.eh_epi && !p.ca && <p class="mt-2 text-[13px] text-ink-muted">O número do CA vem gravado no produto. Confirmamos o número e a validade antes de você fechar. <a href={`https://api.whatsapp.com/send?phone=551139650409&text=${encodeURIComponent(`Olá, Segmento! Qual o número do CA deste item?\n${p.nome} · REF ${p.sku}\n${new URL(`/p/${p.slug}/`, Astro.site)}`)}`} target="_blank" rel="noopener" data-wa="ca-request" class="font-semibold underline hover:text-ink">Pedir o número do CA</a>.</p>}
        <div class="hairline mt-5 pt-5">
          <SeletorVariacao client:load ehEpi={p.eh_epi} id={p.id} slug={p.slug} nome={p.nome} sku={p.sku} ca={p.ca?.numero ?? null} preco={p.preco} precoMin={p.preco_min} precoMax={p.preco_max} emEstoque={p.em_estoque} estoque={p.estoque} atributos={p.atributos} variacoes={vars} categoria={cat.caminho} />
        </div>
        <ul class="hairline mt-5 grid gap-2 pt-5 text-[14px] text-ink-muted sm:grid-cols-2">
          <li class="flex items-center gap-2"><Truck className="h-4 w-4 shrink-0 text-vinho" aria-hidden="true" />Entrega D+1 na Grande SP</li>
          <li class="flex items-center gap-2"><Store className="h-4 w-4 shrink-0 text-vinho" aria-hidden="true" />Retirada em Casa Verde, SP</li>
          <li class="flex items-center gap-2"><FileText className="h-4 w-4 shrink-0 text-vinho" aria-hidden="true" />Nota fiscal e faturamento para CNPJ</li>
          <li class="flex items-center gap-2"><ShieldCheck className="h-4 w-4 shrink-0 text-vinho" aria-hidden="true" />Produto original, com garantia do fabricante</li>
        </ul>
      </div>
    </div>
    <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,4fr)] lg:gap-12">
      <section>
        <h2 id="descricao">Descrição</h2>
        {p.descricao_html
          ? <div class="prose-tec mt-3 max-w-prose text-[15px] leading-6 text-ink-muted" set:html={p.descricao_html} />
          : <p class="mt-3 max-w-prose text-ink-muted">Descrição em revisão. Pergunte qualquer detalhe técnico pelo WhatsApp.</p>}
      </section>
      <section>
        <h2 id="ficha">Ficha técnica</h2>
        <dl class="mt-3 divide-y divide-line text-[15px]">
          <div class="grid min-h-11 grid-cols-[40%_60%] items-center gap-4 py-2.5"><dt class="text-[14px] text-ink-muted">REF</dt><dd class="t-ref font-medium">{p.sku}</dd></div>
          {p.marca && <div class="grid min-h-11 grid-cols-[40%_60%] items-center gap-4 py-2.5"><dt class="text-[14px] text-ink-muted">Marca</dt><dd class="font-medium">{p.marca}</dd></div>}
          <div class="grid min-h-11 grid-cols-[40%_60%] items-center gap-4 py-2.5"><dt class="text-[14px] text-ink-muted">Categoria</dt><dd class="text-right font-medium">{cat.nome_n1} › {cat.nome_n2}</dd></div>
          {p.eh_epi && <div class="grid min-h-11 grid-cols-[40%_60%] items-center gap-4 py-2.5"><dt class="text-[14px] text-ink-muted">CA</dt><dd>{p.ca ? <span class="selo-ca selo-ca-lg"><span>CA</span><span>{p.ca.numero}</span></span> : <span class="font-medium text-ink-muted">consultar</span>}</dd></div>}
          {p.normas.length > 0 && <div class="grid min-h-11 grid-cols-[40%_60%] items-center gap-4 py-2.5"><dt class="text-[14px] text-ink-muted">Normas</dt><dd class="text-right font-medium">{p.normas.join(", ")}</dd></div>}
          {p.atributos.map((a) => <div class="grid min-h-11 grid-cols-[40%_60%] items-center gap-4 py-2.5"><dt class="text-[14px] text-ink-muted">{a.nome}</dt><dd class="text-right font-medium">{a.valores.join(", ")}</dd></div>)}
          <div class="grid min-h-11 grid-cols-[40%_60%] items-center gap-4 py-2.5"><dt class="text-[14px] text-ink-muted">Disponibilidade</dt><dd class="font-medium">{p.em_estoque ? "Em estoque" : "Sob consulta"}</dd></div>
        </dl>
      </section>
    </div>
    {rel.length > 0 && (
      <section class="mt-12">
        <div class="secao-cabeca"><h2>Mesma função em {cat.nome_n2}</h2><a href={`/c/${cat.n1}/${cat.n2}/`} class="text-sm font-medium text-vinho-deep hover:underline">Ver todos</a></div>
        <div class="grade mt-4 grid-cols-2 lg:grid-cols-4">{rel.map((r) => <ProdutoCardR p={r} />)}</div>
      </section>
    )}
  </article>
</Layout>
